# Public SEO pages are opt-in. Build them with npm run build before enabling.
SEO_GUIDE=0
SITE_URL=https://gta-transit-live.onrender.com
NEXT_TELEMETRY_DISABLED=1

# Optional: build-time Search Console HTML verification token (not a password).
GOOGLE_SITE_VERIFICATION=

# Optional dedicated PostgreSQL database for schedule snapshots.
# Do not copy production secrets into this file or commit a filled .env file.
DATABASE_URL=

# Existing live-map/account settings are documented in README.md.
# Keep your current APP_PASSWORD, ACCOUNTS, SESSION_SECRET, Redis and VAPID values.
